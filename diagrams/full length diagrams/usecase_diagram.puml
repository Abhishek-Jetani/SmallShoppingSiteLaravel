@startuml Use Case Diagram - Small Shopping Site

!define RECTANGLE class

left to right direction

actor "Admin" as admin
actor "User" as user
actor "Guest" as guest

rectangle "E-Commerce System" {
    ' Admin Use Cases
    usecase "Login" as UC1
    usecase "View Dashboard" as UC2
    usecase "Manage Products" as UC3
    usecase "Manage Categories" as UC4
    usecase "Manage Orders" as UC5
    usecase "Manage Customers" as UC6
    usecase "View Reports" as UC7
    usecase "Export Products" as UC8
    usecase "Import Products" as UC9
    usecase "Update Profile" as UC10
    usecase "Change Password" as UC11
    
    ' User Use Cases
    usecase "Register" as UC12
    usecase "Login" as UC13
    usecase "Browse Products" as UC14
    usecase "View Product Details" as UC15
    usecase "Search Products" as UC16
    usecase "Filter by Category" as UC17
    usecase "Add to Cart" as UC18
    usecase "View Cart" as UC19
    usecase "Update Cart Quantity" as UC20
    usecase "Remove from Cart" as UC21
    usecase "Add to Wishlist" as UC22
    usecase "View Wishlist" as UC23
    usecase "Remove from Wishlist" as UC24
    usecase "Place Order" as UC25
    usecase "View Orders" as UC26
    usecase "Download Order PDF" as UC27
    usecase "Process Payment" as UC28
    usecase "Update Profile" as UC29
    usecase "Change Password" as UC30
    usecase "Verify Email" as UC31
    
    ' Guest Use Cases
    usecase "Browse Products" as UC32
    usecase "View Product Details" as UC33
    usecase "View Static Pages" as UC34
}

' Admin connections
admin --> UC1
admin --> UC2
admin --> UC3
admin --> UC4
admin --> UC5
admin --> UC6
admin --> UC7
admin --> UC8
admin --> UC9
admin --> UC10
admin --> UC11

' User connections
user --> UC13
user --> UC14
user --> UC15
user --> UC16
user --> UC17
user --> UC18
user --> UC19
user --> UC20
user --> UC21
user --> UC22
user --> UC23
user --> UC24
user --> UC25
user --> UC26
user --> UC27
user --> UC28
user --> UC29
user --> UC30
user --> UC31

' Guest connections
guest --> UC32
guest --> UC33
guest --> UC34

' Relationships
UC3 ..> UC4 : <<include>>
UC5 ..> UC3 : <<include>>
UC18 ..> UC14 : <<include>>
UC19 ..> UC18 : <<include>>
UC25 ..> UC19 : <<include>>
UC25 ..> UC28 : <<include>>
UC28 ..> UC25 : <<extend>>
UC12 ..> UC31 : <<include>>

@enduml

